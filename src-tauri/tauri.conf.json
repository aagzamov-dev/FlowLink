{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowLink",
  "version": "1.0.0",
  "identifier": "app.flowlink.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowLink",
        "width": 1000,
        "height": 720,
        "minWidth": 820,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "quick",
        "title": "FlowLink",
        "url": "index.html?panel=quick",
        "width": 370,
        "height": 540,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0QzJBM0E3N0E3MkFGQTcKUldTbnIzSjZwNlBDaEc3Y3ZjblZlK01GZ21WeG5lMHcxMlcxUUw5OWthdDRyY0xsM0wyZWF2bE4K",
      "endpoints": [
        "https://github.com/aagzamov-dev/FlowLink/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
